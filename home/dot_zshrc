#!/usr/bin/env zsh
#==============================================================================#
#                                     ZSH                                      #
#                                                                              #
# @file:   ~/.zshrc                                                            #
# @author: hradecek <ivohradek@gmail.com>                                      #
#==============================================================================#
BASE_DIR=${HOME}/dotfiles
BASE_SHELL_DIR=${BASE_DIR}/shell

# SSH — use the gcr-ssh-agent (gnome-keyring) socket and supply the key's
# passphrase from the auto-unlocked login keyring, so it never prompts.
# Store the passphrase once with:
#   secret-tool store --label='ssh id_ed25519' ssh-key id_ed25519
export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR}/gcr/ssh"
export SSH_ASKPASS="${BASE_SHELL_DIR}/ssh/askpass-keyring.sh"
export SSH_ASKPASS_REQUIRE=prefer

load_aliases() {
    local alias_dir="$1"
    if [ -d "${alias_dir}" ]; then
        for alias_file in "${alias_dir}"/*.aliases.sh(.N); do
            source "${alias_file}"
        done
    else
        echo "Warning: Alias directory '${alias_dir}' does not exist."
    fi
}

setopt AUTO_CD
setopt PROMPT_SUBST

export EDITOR='nvim'
export JAVA_HOME=/usr/lib/jvm/default

# Directory & file listing colors (managed dircolors -> LS_COLORS)
if command -v dircolors >/dev/null && [ -f ~/.dircolors ]; then
    eval "$(dircolors -b ~/.dircolors)"
fi

# Emacs keymap explicitly - zsh picks viins when $EDITOR contains "vi"
bindkey -e
bindkey "^P" up-line-or-search
bindkey "^N" down-line-or-search
bindkey "^A" vi-beginning-of-line
bindkey "^E" vi-end-of-line
# Word motion stops at / - . (like bash readline)
WORDCHARS=${WORDCHARS//[\/\-.]}
# Ctrl+Left/Right word motion (xterm sequences, not in zsh's default emacs keymap)
bindkey "^[[1;5D" backward-word
bindkey "^[[1;5C" forward-word
bindkey "^[b" backward-word
bindkey "^[f" forward-word
bindkey "^W" backward-kill-word
bindkey "^[^?" backward-kill-word
bindkey "^[d" kill-word
bindkey "^U" kill-whole-line
bindkey "^K" kill-line
bindkey "^Y" yank

load_aliases "${BASE_SHELL_DIR}/aliases"
source ${BASE_SHELL_DIR}/zsh/history.zsh

# Completion (zsh-completions installs into the default fpath)
autoload -Uz compinit && compinit

# fzf key bindings: Ctrl+R history, Ctrl+T file path, Alt+C cd
# fd honours .gitignore; bat previews the file under the cursor
export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'
export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
export FZF_CTRL_T_OPTS="--preview 'bat --color=always --line-range :200 {}'"
export FZF_ALT_C_COMMAND='fd --type d --hidden --exclude .git'
command -v fzf >/dev/null && source <(fzf --zsh)

# zoxide: `z <fragment>` jumps to a frequently used directory
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# Plugins — installed by pacman (see .chezmoidata/packages.yaml).
# syntax-highlighting must be sourced last: it wraps the widgets defined above.
for plugin in zsh-autosuggestions zsh-syntax-highlighting; do
    plugin_file="/usr/share/zsh/plugins/${plugin}/${plugin}.zsh"
    [ -f "${plugin_file}" ] && source "${plugin_file}"
done
unset plugin plugin_file

# Prompt — Starship (shared cross-OS config at ~/.config/starship.toml)
command -v starship >/dev/null && eval "$(starship init zsh)"

export PATH="$HOME/.local/bin:$PATH"

# opencode
export PATH="$HOME/.opencode/bin:$PATH"

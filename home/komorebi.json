{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.41/schema.json",
  "window_hiding_behaviour": "Cloak",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 4,
  "default_container_padding": 4,
  "border": true,
  "border_width": 2,
  "border_offset": -1,
  "border_colours": {
    "single": "#8fe0a8",
    "stack": "#44a022",
    "monocle": "#8fe0a8",
    "unfocused": "#2a3a30"
  },
  "monitors": [
    {
      "workspaces": [
        { "name": "1", "layout": "VerticalStack" },
        { "name": "2", "layout": "VerticalStack" },
        { "name": "3", "layout": "VerticalStack" },
        { "name": "4", "layout": "VerticalStack" },
        { "name": "5", "layout": "VerticalStack" },
        { "name": "6", "layout": "VerticalStack" },
        { "name": "7", "layout": "VerticalStack" },
        { "name": "8", "layout": "VerticalStack" },
        { "name": "9", "layout": "VerticalStack" }
      ]
    }
  ]
}

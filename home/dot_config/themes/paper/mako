# paper: base sheet, ink text, green hairline.

font=Iosevka Nerd Font 11

background-color=#f4f1ea
text-color=#2b2a27
border-color=#3d7a58
progress-color=over #d3ccbd
border-size=1
border-radius=6

[urgency=low]
border-color=#d3ccbd
text-color=#7a756b

[urgency=normal]
border-color=#3d7a58

# Critical: red, and it stays until dismissed
[urgency=critical]
border-color=#b3261e
text-color=#2b2a27
default-timeout=0

{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 8,
  "margin-top": 2,
  "margin-left": 2,
  "margin-right": 2,
  "reload_style_on_change": true,
  "modules-left": [
    "river/tags",
    "river/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "custom/pacman",
    "idle_inhibitor",
    "group/hardware",
    "network",
    "bluetooth",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/kblayout",
    "custom/notification",
    "tray",
    "custom/power"
  ],
  "group/hardware": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "hw-child",
      "transition-left-to-right": false
    },
    "modules": [
      "cpu",
      "memory",
      "temperature",
      "disk"
    ]
  },
  "river/tags": {
    "num-tags": 9,
    "tag-labels": ["1", "2", "3", "4", "5", "6", "7", "8", "9"]
  },
  "custom/pacman": {
    "format": "{icon} {text}",
    "return-type": "json",
    "format-icons": {
      "pending-updates": "󰚰",
      "updated": ""
    },
    "exec": "waybar-updates"
  },
  "custom/kblayout": {
    "format": "󰌌 {}",
    "return-type": "json",
    "exec": "~/.config/river/kb-layout.sh status",
    "signal": 8,
    "on-click": "~/.config/river/kb-layout.sh toggle"
  },
  "custom/notification": {
    "exec": "~/.config/waybar/notification.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": true,
    "on-click": "makoctl mode -t do-not-disturb",
    "on-click-right": "makoctl dismiss --all"
  },
  "custom/power": {
    "format": "󰐥",
    "tooltip": false,
    "on-click": "~/.config/waybar/power-menu.sh"
  },
  "river/window": {
    "max-length": 50,
    "tooltip": false
  },
  "cpu": {
    "interval": 2,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
    "format-alt": "  {avg_frequency}GHz",
    "tooltip-format": "CPU: {usage}%\n{load}",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "clock": {
    "timezone": "Europe/Prague",
    "format": "  {:%H:%M}",
    "format-alt": "  {:%A, %B %d, %Y (%R)}",
    "tooltip-format": "<tt><big>{calendar}</big></tt>",
    "locale": "en_GB.UTF-8",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 4,
      "weeks-pos": "left",
      "on-scroll": 1,
      "format": {
        "months": "<b>{}</b>",
        "days": "<b>{}</b>",
        "weeks": "<span alpha='55%'><b>W{}</b></span>",
        "weekdays": "<span alpha='70%'><b>{}</b></span>",
        "today": "<b><u>{}</u></b>"
      }
    },
    "actions": {
      "on-click-right": "mode",
      "on-scroll-up": "shift_up",
      "on-scroll-down": "shift_down"
    }
  },
  "battery": {
    "states": {
      "good": 80,
      "warning": 30,
      "critical": 15
    },
    "tooltip-format": "{timeTo}, {capacity}%",
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": [
      "󰂃",
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ]
  },
  "network": {
    "format-wifi": "   {essid}",
    "format-ethernet": "󰈀  {ifname}: {ipaddr}/{cidr}",
    "format-linked": "{ifname} (No IP)",
    "format-disconnected": "󰖪 Disconnected",
    "format-alt": "{ifname}: {ipaddr}/{cidr} [{signalStrength}%]",
    "tooltip-format": "{ifname}: {ipaddr}",
    "on-click": "nm-connection-editor"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-off": "󰂲",
    "format-disabled": "󰂲",
    "format-connected": "󰂱 {num_connections}",
    "format-connected-battery": "󰂱 {device_battery_percentage}%",
    "tooltip-format": "{controller_alias}: {status}",
    "tooltip-format-connected": "{controller_alias}\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}",
    "tooltip-format-enumerate-connected-battery": "{device_alias} {device_battery_percentage}%",
    "on-click": "blueman-manager",
    "on-click-right": "rfkill toggle bluetooth"
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰸈 {volume}%",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "scroll-step": 2,
    "on-click": "alacritty -e alsamixer",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },
  "memory": {
    "interval": 5,
    "format": "{}%",
    "format-alt": "{used:0.1f}G/{total:0.1f}G",
    "tooltip-format": "RAM: {used:0.1f}G/{total:0.1f}G ({percentage}%)\nSwap: {swapUsed:0.1f}G/{swapTotal:0.1f}G",
    "states": {
      "warning": 70,
      "critical": 90
    }
  },
  "temperature": {
    "hwmon-path-abs": "/sys/devices/platform/coretemp.0/hwmon",
    "input-filename": "temp1_input",
    "interval": 5,
    "format": "{temperatureC}°C",
    "format-critical": "{temperatureC}°C",
    "critical-threshold": 90,
    "tooltip-format": "CPU package: {temperatureC}°C"
  },
  "disk": {
    "interval": 30,
    "format": "{percentage_used}%",
    "format-alt": "{used}/{total}",
    "path": "/",
    "tooltip-format": "Disk: {used} used of {total} ({percentage_used}%)"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪"
    },
    "tooltip-format-activated": "Idle inhibitor: activated",
    "tooltip-format-deactivated": "Idle inhibitor: deactivated"
  },
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "tooltip-format": "Brightness: {percent}%"
  },
  "tray": {
    "icon-size": 16,
    "spacing": 8
  }
}

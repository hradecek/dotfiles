#==============================================================================#
#                                 ALACRITTY                                    #
#                                                                              #
# @file:   $HOME/.confg/alacritty/alacritty.yml                                #
# @author: hradecek <ivohradek@gmail.com>                                      #
#==============================================================================#
# Colors and font come from the active theme (~/.config/themes/current, switched
# by `theme` on Linux). Windows has no theme switcher and stays on colors2.
[general]
import = [
{{- if eq .chezmoi.os "windows" }}
  "~/.config/themes/colors2/alacritty.toml"
{{- else }}
  "~/.config/themes/current/alacritty.toml"
{{- end }}
]
{{- if eq .chezmoi.os "windows" }}
# Open new windows in the projects directory.
working_directory = 'C:\projects'
{{- end }}

[env]
# Windows git ships a `less` pager with no `alacritty` terminfo entry, so it
# treats the terminal as dumb ("terminal is not fully functional"). Send a TERM
# it recognizes there; Linux has the alacritty terminfo from the package.
{{- if eq .chezmoi.os "windows" }}
TERM = "xterm-256color"
{{- else }}
TERM = "alacritty"
{{- end }}
LANG = "en_US.UTF-8"
LC_CTYPE = "en_US.UTF-8"

[window]
title = "Terminal"
opacity = 0.95

{{- if eq .chezmoi.os "windows" }}

# Windows: launch PowerShell 7 instead of the default Windows PowerShell 5.1.
# Use the MSI install's fixed path — NOT the WindowsApps App Execution Alias
# (a 0-byte reparse stub Alacritty can't spawn) and NOT the versioned Store
# path under WindowsApps (changes on every PS update). Install with the MSI
# from github.com/PowerShell/PowerShell so this path stays stable.
[terminal.shell]
program = 'C:\Program Files\PowerShell\7\pwsh.exe'
args = ["-NoLogo"]
{{- end }}
